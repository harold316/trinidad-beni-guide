rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isEmpresa() {
      return isSignedIn() && (userDoc().role == 'empresa' || isAdmin());
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isEmpresa();
      allow update, delete: if isAdmin() || (isEmpresa() && resource.data.ownerId == request.auth.uid);

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || resource.data.userId == request.auth.uid;
      }
    }

    match /promotions/{id} {
      allow read: if true;
      allow write: if isEmpresa();
    }

    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter/{email} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
